# CLIENT configuration. Everything EXPO_PUBLIC_* is visible to app users.
# Never put API keys here.
EXPO_PUBLIC_JOB_SOURCE=live

# Browser on this computer / iOS Simulator:
EXPO_PUBLIC_JOBS_API_URL=http://localhost:8787
# Physical phone: use your computer's LAN address, e.g. http://192.168.1.10:8787
# Android Emulator: http://10.0.2.2:8787

# To use only sample listings without an API key, change the source to demo.
# EXPO_PUBLIC_JOB_SOURCE=demo
