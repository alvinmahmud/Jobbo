# SERVER ONLY. Copy this file to .env in the repository root.
# Direct OpenWeb Ninja JSearch key (not a RapidAPI marketplace key).
OPENWEBNINJA_API_KEY=

# Local-only defaults. Do not expose this proxy publicly without authentication
# and shared rate/spend limits. These in-memory limits reset on restart.
HOST=127.0.0.1
PORT=8787
JOBS_UPSTREAM_HOURLY_LIMIT=20
JOBS_PER_IP_LIMIT=30
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
